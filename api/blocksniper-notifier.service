[Unit]
# Sub-second block notifications via ZMQ hashblock and ckpool.log tailer.
# See api/NOTIFIER.md.
#
# Three things to set before enabling this unit:
#   1. User= / Group=          the account that RUNS ckpool. ckpool creates its
#                              logdir and config mode 0750/0600, so a different user
#                              cannot read them without the proper credentials.
#                              Set this to `elo` on production (solo), `bch` on test (beast).
#   2. ExecStart=              path to the built blocksniper-notifier binary
#                              (normally /usr/local/bin/blocksniper-notifier).
#   3. EnvironmentFile=        the env file created below (normally
#                              /etc/blocksniper-notifier/notifier.env).
#
# The secret (BLOCKSNIPER_NOTIFY_SECRET) must come from the environment file,
# NOT from an Environment= line here: unit files are world readable and
# `systemctl show` prints every Environment= variable to any user. The secret
# belongs in a file mode 0600 owned by the run user.

Description=BlockSniper Notifier (ZMQ + log tailer)
Documentation=https://github.com/skaisser/blocksniper-ckpool
After=network-online.target
Wants=network-online.target

# StartLimit* belong in [Unit] on systemd >= 229.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=CHANGEME
Group=CHANGEME
ExecStart=/usr/local/bin/blocksniper-notifier

# Environment variables from the notifier.env file (mode 0600).
# BLOCKSNIPER_NOTIFY_URL, BLOCKSNIPER_NOTIFY_SECRET, CKPOOL_CONF_PATH,
# CKPOOL_LOG_PATH, NOTIFY_DRY_RUN (defaults to true).
EnvironmentFile=/etc/blocksniper-notifier/notifier.env

Restart=always
RestartSec=5

# Resource limits and security posture.
MemoryMax=64M
CPUQuota=10%
TasksMax=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=blocksniper-notifier

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
