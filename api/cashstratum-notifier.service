[Unit]
# Sub-second block notifications via ZMQ hashblock and stratum log tailer.
# See api/NOTIFIER.md.
#
# Three things to set before enabling this unit:
#   1. User= / Group=          the account that RUNS cashstratum. cashstratum creates its
#                              logdir and config mode 0750/0600, so a different user
#                              cannot read them without the proper credentials.
#   2. ExecStart=              path to the built cashstratum-notifier binary
#                              (normally /usr/local/bin/cashstratum-notifier).
#   3. EnvironmentFile=        the env file created below (normally
#                              /etc/cashstratum-notifier/cashstratum-notifier.env).
#
# The secret (CASHSTRATUM_NOTIFY_SECRET) must come from the environment file,
# NOT from an Environment= line here: unit files are world readable and
# `systemctl show` prints every Environment= variable to any user. The secret
# belongs in a file mode 0600 owned by the run user.

Description=CashStratum Notifier (ZMQ + log tailer)
Documentation=https://github.com/cashstratum/cashstratum
After=network-online.target
Wants=network-online.target

# StartLimit* belong in [Unit] on systemd >= 229.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=CHANGEME
Group=CHANGEME
ExecStart=/usr/local/bin/cashstratum-notifier

# Environment variables from the notifier env file (mode 0600).
# CASHSTRATUM_NOTIFY_URL, CASHSTRATUM_NOTIFY_SECRET, CASHSTRATUM_CONF_PATH,
# CASHSTRATUM_LOG_PATH, NOTIFY_DRY_RUN (defaults to true).
EnvironmentFile=/etc/cashstratum-notifier/cashstratum-notifier.env

Restart=always
RestartSec=5

# Resource limits and security posture.
MemoryMax=64M
CPUQuota=10%
TasksMax=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cashstratum-notifier

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
