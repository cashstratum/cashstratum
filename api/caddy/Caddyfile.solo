# Caddyfile — solo.blocksniper.ai
#
# Terminates 443 in front of the unprivileged ckpool-api process (127.0.0.1:8888) and
# exposes exactly one public path: GET /ping (contract: browser-latency-ping.md).
# Everything else answers 404 — this is a TLS front door for one endpoint, not a
# general-purpose reverse proxy. Installed only on the production ("solo") host; beast
# keeps its existing Traefik and never gets this file (see api/caddy/README.md).
#
# TLS-ALPN-01 only (port 80 is closed and stays closed), hostname solo.blocksniper.ai,
# 443 opened knowingly on the pool host.
{
	# No admin API — nothing on this host should be able to reconfigure Caddy over HTTP.
	admin off

	# Port 80 is firewalled and stays that way (D2). Caddy would otherwise try to listen
	# there for HTTP->HTTPS redirects and for HTTP-01 ACME challenges; disable both so it
	# never attempts a bind that ufw would just drop.
	auto_https disable_redirects
}

solo.blocksniper.ai {
	tls {
		# HTTP-01 needs port 80, which is closed on this host (contract §4). Restricting
		# to disable_http_challenge leaves TLS-ALPN-01 as the only issuance path Caddy will
		# attempt, and TLS-ALPN-01 only needs the 443 listener this block already owns.
		issuer acme {
			disable_http_challenge
		}
	}

	# The only public route. reverse_proxy adds X-Forwarded-For automatically; that is
	# what the Go limiter's getClientIP() reads once RemoteAddr is loopback (D6) — no
	# extra header directive needed here.
	@ping path /ping
	handle @ping {
		reverse_proxy 127.0.0.1:8888
	}

	# Everything else: no data, no probing the rest of the API surface from the internet.
	handle {
		respond 404
	}

	# No access log directive — contract §6: no client-IP logging beyond what already
	# exists (the Go process's own rate-limit bookkeeping).

	# No explicit timeouts: Caddy's defaults (and its default keep-alive) are already
	# comfortably under the Go server's 10s read/write timeouts, so leave them unset
	# rather than risk configuring something looser than the backend.
}
