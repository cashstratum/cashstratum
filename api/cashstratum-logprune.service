[Unit]
# Log pruning service for cashstratum's per-height sharelog directories.
#
# This service runs the clean-old-blocks.sh script to remove outdated
# sharelog directories (000xxxx) and old rotated log files from the
# cashstratum log tree. It is triggered daily by cashstratum-logprune.timer.
#
# ############################################################################
# TEMPLATE -- adjust paths and user for your deployment.
#
# Edit Environment=, WorkingDirectory=, ExecStart= and User= before installing,
# and verify with:
#
#   systemctl cat cashstratum-logprune.service   # paths you actually have?
#   sudo systemctl start cashstratum-logprune    # run it ONCE, by hand, first
#   journalctl -u cashstratum-logprune -n 50     # did it do what you expected?
#
# clean-old-blocks.sh takes --dry-run. Use it before the first real run.
#
# ############################################################################
# Solve protection is IN clean-old-blocks.sh -- keep it that way.
#
# On a solo pool the sharelog of a height you actually solved is the per-share
# record behind a block you were paid for, and once rm -rf has taken it there
# is no second copy anywhere. The script therefore builds a persistent,
# append-only solve index before pruning, skips every height in it, and REFUSES
# to delete anything if the index cannot be built.

Description=CashStratum Log Pruning Service
Documentation=https://github.com/cashstratum/cashstratum
After=multi-user.target

[Service]
Type=oneshot
User=cashstratum
Group=cashstratum
WorkingDirectory=/opt/cashstratum

Environment=CASHSTRATUM_DIR=/opt/cashstratum
ExecStart=/opt/cashstratum/clean-old-blocks.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cashstratum-logprune

# Since this runs as oneshot, there's no restart policy. The timer
# handles scheduling.
